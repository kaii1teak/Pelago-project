# Copy to .env.local. Everything here is optional: Pelago works without a key,
# just with CoinGecko's stricter anonymous rate limits.

# CoinGecko Demo API key (free): https://www.coingecko.com/en/api/pricing
# Server-only. Never prefix with NEXT_PUBLIC_, the browser must not see it.
COINGECKO_API_KEY=

# Override only if you use a different CoinGecko host/plan.
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3
